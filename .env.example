# Tomba API Credentials
# Get your keys at https://app.tomba.io/api

# API Key (format: ta_xxxxxxxxxx)
TOMBA_API_KEY=ta_your_api_key

# Secret Key (format: ts_xxxxxxxxxx)
TOMBA_SECRET_KEY=ts_your_secret_key

# Bearer Token (base64 of api_key:secret_key)
# Generate with: echo -n 'ta_your_api_key:ts_your_secret_key' | base64
TOMBA_BEARER_TOKEN=your_base64_encoded_token
